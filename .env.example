# Server Port
PORT=8000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/localHostDining

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Email Transporter (Mailtrap Sandbox / Brevo / Resend / Gmail SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=reservations@localhostdining.com
FROM_NAME="LocalHost Dining"

# Frontend Application URL
FRONTEND_URL=http://localhost:3000

# Cloudinary Cloud Storage (Free tier from cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
